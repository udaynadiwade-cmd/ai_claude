# Copy to .env (gitignored) — or just run: python3 connect.py
# Never commit real values.

# Shoonya API — the source of truth. Same login as trade.shoonya.com.
SHOONYA_USER=
SHOONYA_PWD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR=
SHOONYA_APIKEY=

# Optional — OpenAlgo REST, used only if the SHOONYA_* block is empty.
# Tradebook only, no order book, no rejections.
# OPENALGO_URL=http://127.0.0.1:5000
# OPENALGO_APIKEY=

CAPITAL_PER_STOCK=10000
# Session cutoff: exits after this count as timer square-offs (WINDOW rule)
FLAT_BY=15:00
