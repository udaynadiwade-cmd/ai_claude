# Copy to .env (gitignored). Never commit real values.

# Preferred — OpenAlgo already holds your Shoonya login
OPENALGO_URL=http://127.0.0.1:5000
OPENALGO_APIKEY=

# Fallback — Shoonya direct (needs: pip install pyotp)
SHOONYA_USER=
SHOONYA_PWD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR=
SHOONYA_APIKEY=

CAPITAL_PER_STOCK=10000
